# Server
PORT=3001
NODE_ENV=production

# OCI Email Delivery / SMTP Configuration
SMTP_HOST=smtp.email.ap-tokyo-1.oci.oraclecloud.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ocid1.user.oc1...<your_smtp_username>
SMTP_PASS=your_oci_smtp_approved_password
DEFAULT_FROM="Sanchez Solutions Notifications <noreply@sanchez.ph>"

# Authorized Client API Keys (comma-separated)
# These map to client apps: solutions-portfolio, trace, equiyield, ccard-studio
ALLOWED_API_KEYS=trace_key_123,equiyield_key_456,solutions_key_789,ccard_key_000
